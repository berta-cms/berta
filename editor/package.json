{
  "name": "berta",
  "version": "2.9.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node copy-twig-templates.mjs && node bundle-twig-templates.js",
    "build": "ng build --configuration production",
    "dev": "ng build --watch --configuration development",
    "test": "ng test",
    "sentry:sourcemaps": "npm run build && sentry-cli sourcemaps inject --org hello-world-ik --project berta-frontend --release $npm_package_version ../engine/dist && sentry-cli sourcemaps upload --org hello-world-ik --project berta-frontend --release $npm_package_version ../engine/dist"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.22",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.22",
    "@angular/compiler": "^21.2.22",
    "@angular/core": "^21.2.22",
    "@angular/forms": "^21.2.22",
    "@angular/platform-browser": "^21.2.22",
    "@angular/platform-browser-dynamic": "^21.2.22",
    "@angular/router": "^21.2.22",
    "@kolkov/angular-editor": "^2.1.0",
    "@ngxs/store": "~21.0.0",
    "@sentry/angular": "^10.18.0",
    "lodash": "^4.17.21",
    "marked": "^17.0.4",
    "ng-sortgrid": "^21.0.0",
    "ngx-color-picker": "^20.1.1",
    "ngx-image-cropper": "^9.1.5",
    "ngx-tooltip-directives": "^21.0.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.0.0",
    "twig": "^2.0.0",
    "webfontloader": "^1.6.28",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.23",
    "@angular/cli": "^21.2.23",
    "@angular/compiler-cli": "^21.2.22",
    "@angular/language-service": "^21.2.22",
    "@ngxs/devtools-plugin": "~21.0.0",
    "@ngxs/logger-plugin": "~21.0.0",
    "@sentry/cli": "^2.56.0",
    "@types/jasmine": "~5.1.0",
    "@types/lodash": "^4.14.182",
    "@types/node": "^20.14.8",
    "cpy": "^12.0.1",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  }
