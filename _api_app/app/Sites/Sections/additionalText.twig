<div{{ wrapperAttributes|raw }}>
  {% if isEditMode %}
    <div class="xHandle"></div>
  {% endif %}
  {% if content.attributes %}
    <div{{ content.attributes|raw }}>{% if content.html %}{{ content.html|raw }}{% else %}<span class="xEmpty">&nbsp;additional text&nbsp;</span>{% endif %}</div>
  {% else %}
    {{ content.html|raw }}
  {% endif %}
</div>
