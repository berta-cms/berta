<div id="shoppingCartOuter" class="cart">
  <h1 id="shoppingCartTitle" class="cart-title">Cart</h1>

  <div id="shoppingCartEmpty" class="cart-title">
    <div class="xNgEditable xProperty-cartTextEmpty xCaption-Shopping+cart+empty" data-path="blog/settings/siteTexts/cartTextEmpty" data-empty-caption="Shopping cart empty">Custom cartTextEmpty</div>
  </div>

  <div class="cart-notice cart-expired js-cart-expired">
    <div class="xNgEditable xProperty-cartTextExpired xCaption-Shopping+cart+is+expired" data-path="blog/settings/siteTexts/cartTextExpired" data-empty-caption="Shopping cart is expired">Custom cartTextExpired</div>
  </div>

  <div class="cart-order-placed js-cart-order-placed hidden">
    <h2 class="cart-order-placed-headline js-cart-order-placed-headline"></h2>
    <p class="cart-order-placed-next-step js-cart-order-placed-next-step"></p>
    <p class="cart-notice js-cart-order-number"></p>
    <button type="button" class="cart-button cart-button--primary" onclick="closeShoppingCart();">Custom cartTextReturnStore</button>
  </div>

  <div class="cart-contents js-cart-contents">
    <div class="cart-lines-head">
      <div class="cart-line-name"><span class="xNgEditable xProperty-cartTextTitle xCaption-Title" data-path="blog/settings/siteTexts/cartTextTitle" data-empty-caption="Title">Custom cartTextTitle</span></div>
      <div class="cart-line-quantity"><span class="xNgEditable xProperty-cartTextQuantity xCaption-Quantity" data-path="blog/settings/siteTexts/cartTextQuantity" data-empty-caption="Quantity">Custom cartTextQuantity</span></div>
      <div class="cart-line-price"><span class="xNgEditable xProperty-cartTextPrice xCaption-Price" data-path="blog/settings/siteTexts/cartTextPrice" data-empty-caption="Price">Custom cartTextPrice</span></div>
      <div class="cart-line-sum"><span class="xNgEditable xProperty-cartTextSum xCaption-Sum" data-path="blog/settings/siteTexts/cartTextSum" data-empty-caption="Sum">Custom cartTextSum</span> (EUR)</div>
    </div>

    <ul class="cart-lines js-cart-lines"></ul>

        <template class="js-cart-line-template">
      <li class="cart-line js-cart-line">
        <div class="cart-line-image js-cart-line-image hidden"></div>
        <div class="cart-line-name js-cart-line-name"></div>
        <div class="cart-line-quantity cart-stepper">
          <button type="button" class="cart-stepper-button js-cart-quantity-decrease" aria-label="Remove one">
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3.5 8h9" /></svg>
          </button>
          <span class="cart-stepper-value js-cart-line-quantity"></span>
          <button type="button" class="cart-stepper-button js-cart-quantity-increase" aria-label="Add one">
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3.5 8h9M8 3.5v9" /></svg>
          </button>
        </div>
        <div class="cart-line-price js-cart-line-price"></div>
        <div class="cart-line-sum js-cart-line-sum"></div>
      </li>
    </template>

    <div class="cart-options">
              <div class="cart-field">
          <label class="cart-label" for="promo_code"><span class="xNgEditable xProperty-cartTextPromoCode xCaption-Promo+code" data-path="blog/settings/siteTexts/cartTextPromoCode" data-empty-caption="Promo code">Custom cartTextPromoCode</span></label>
          <div class="cart-input-group">
            <input class="cart-input" type="text" name="promo_code" id="promo_code" autocomplete="off">
                          <div class="cart-button cart-button--secondary"><span class="xNgEditable xProperty-cartTextPromoBtn xCaption-OK" data-path="blog/settings/siteTexts/cartTextPromoBtn" data-empty-caption="OK">Custom cartTextPromoBtn</span></div>
                      </div>
        </div>
      
      <div class="cart-field">
        <label class="cart-label" for="shipping_select"><span class="xNgEditable xProperty-cartTextShippingTo xCaption-Shipping+to" data-path="blog/settings/siteTexts/cartTextShippingTo" data-empty-caption="Shipping to">Custom cartTextShippingTo</span></label>
        <select class="cart-select" id="shipping_select">
                      <option value="1">Europe</option>
                  </select>
      </div>
    </div>

    <dl class="cart-totals">
      <div class="cart-totals-row">
        <dt><span class="xNgEditable xProperty-shippingTotalText xCaption-Shipping" data-path="blog/settings/siteTexts/shippingTotalText" data-empty-caption="Shipping">Custom shippingTotalText</span></dt>
        <dd><span class="js-cart-shipping-sum"></span> EUR</dd>
      </div>
      <div class="cart-totals-row js-cart-discount">
        <dt><span class="xNgEditable xProperty-cartTextDiscount xCaption-Discount" data-path="blog/settings/siteTexts/cartTextDiscount" data-empty-caption="Discount">Custom cartTextDiscount</span></dt>
        <dd class="js-cart-discount-percent"></dd>
      </div>
      <div class="cart-totals-row cart-totals-row--total">
        <dt><span class="xNgEditable xProperty-cartTextTotal xCaption-Total" data-path="blog/settings/siteTexts/cartTextTotal" data-empty-caption="Total">Custom cartTextTotal</span></dt>
        <dd><span class="js-cart-total"></span> EUR</dd>
      </div>
      <div class="cart-totals-row cart-totals-row--vat js-cart-vat">
        <dt><span class="xNgEditable xProperty-cartTextInclVat xCaption-Incl+vat" data-path="blog/settings/siteTexts/cartTextInclVat" data-empty-caption="Incl vat">Custom cartTextInclVat</span> (<span class="js-cart-vat-rate"></span>%)</dt>
        <dd><span class="js-cart-vat-amount"></span> EUR</dd>
      </div>
    </dl>
  </div>

  <div class="cart-checkout js-cart-checkout">
    <section class="cart-section">
      <h2 class="cart-section-title"><span class="xNgEditable xProperty-cartTextBillAddr xCaption-Billing+address" data-path="blog/settings/siteTexts/cartTextBillAddr" data-empty-caption="Billing address">Custom cartTextBillAddr</span></h2>

      <label class="cart-check">
        <input type="checkbox" id="cartTextLegalPerson" value="1">
        <span class="xNgEditable xProperty-cartTextLegalPerson xCaption-Legal+person" data-path="blog/settings/siteTexts/cartTextLegalPerson" data-empty-caption="Legal person">Custom cartTextLegalPerson</span>
      </label>

      <div class="cart-fields">
        <div class="cart-field cart-field--required js-cart-field js-cart-company-field">
          <label class="cart-label" for="company"><span class="xNgEditable xProperty-cartTextCompany xCaption-Company" data-path="blog/settings/siteTexts/cartTextCompany" data-empty-caption="Company">Custom cartTextCompany</span></label>
          <input class="cart-input" type="text" name="company" id="company" autocomplete="billing organization" aria-required="true">
        </div>

        <div class="cart-field cart-field--required js-cart-field js-cart-company-field">
          <label class="cart-label" for="company_reg_no"><span class="xNgEditable xProperty-cartTextCompanyRegNo xCaption-Company+reg.+no." data-path="blog/settings/siteTexts/cartTextCompanyRegNo" data-empty-caption="Company reg. no.">Custom cartTextCompanyRegNo</span></label>
          <input class="cart-input" type="text" name="company_reg_no" id="company_reg_no" autocomplete="off" aria-required="true">
        </div>

        <div class="cart-field cart-field--wide cart-field--required js-cart-field js-cart-company-field">
          <label class="cart-label" for="legal_address"><span class="xNgEditable xProperty-cartTextLegalAddress xCaption-Legal+address" data-path="blog/settings/siteTexts/cartTextLegalAddress" data-empty-caption="Legal address">Custom cartTextLegalAddress</span></label>
          <input class="cart-input" type="text" name="legal_address" id="legal_address" autocomplete="off" aria-required="true">
        </div>

        <div class="cart-field cart-field--wide cart-field--required js-cart-field">
          <label class="cart-label" for="name"><span class="xNgEditable xProperty-cartTextNameSurname xCaption-Name+surname" data-path="blog/settings/siteTexts/cartTextNameSurname" data-empty-caption="Name surname">Custom cartTextNameSurname</span></label>
          <input class="cart-input" type="text" name="name" id="name" autocomplete="billing name" aria-required="true">
        </div>

        <div class="cart-field cart-field--wide cart-field--required js-cart-field">
          <label class="cart-label" for="address"><span class="xNgEditable xProperty-cartTextAddress xCaption-Address" data-path="blog/settings/siteTexts/cartTextAddress" data-empty-caption="Address">Custom cartTextAddress</span></label>
          <input class="cart-input" type="text" name="address" id="address" autocomplete="billing street-address" aria-required="true">
        </div>

        <div class="cart-field cart-field--required js-cart-field">
          <label class="cart-label" for="phone"><span class="xNgEditable xProperty-cartTextPhoneNumber xCaption-Phone+number" data-path="blog/settings/siteTexts/cartTextPhoneNumber" data-empty-caption="Phone number">Custom cartTextPhoneNumber</span></label>
          <input class="cart-input" type="tel" name="phone" id="phone" autocomplete="billing tel" aria-required="true">
        </div>

        <div class="cart-field cart-field--required js-cart-field">
          <label class="cart-label" for="email"><span class="xNgEditable xProperty-cartTextEmail xCaption-Email" data-path="blog/settings/siteTexts/cartTextEmail" data-empty-caption="Email">Custom cartTextEmail</span></label>
          <input class="cart-input" type="email" name="email" id="email" autocomplete="billing email" aria-required="true">
        </div>

        <div class="cart-field cart-field--wide js-cart-field">
          <label class="cart-label" for="notes"><span class="xNgEditable xProperty-cartTextComments xCaption-Comments" data-path="blog/settings/siteTexts/cartTextComments" data-empty-caption="Comments">Custom cartTextComments</span></label>
          <textarea class="cart-input" rows="3" name="notes" id="notes"></textarea>
        </div>
      </div>

      <label class="cart-check">
        <input type="checkbox" id="deliver_billing_addr" checked="checked">
        <span class="xNgEditable xProperty-cartTextDeliverBilling xCaption-Deliver+to+billing_address" data-path="blog/settings/siteTexts/cartTextDeliverBilling" data-empty-caption="Deliver to billing_address">Custom cartTextDeliverBilling</span>
      </label>
    </section>

    <section class="cart-section js-cart-shipping-address">
      <h2 class="cart-section-title"><span class="xNgEditable xProperty-cartTextShipAddr xCaption-Shipping+address" data-path="blog/settings/siteTexts/cartTextShipAddr" data-empty-caption="Shipping address">Custom cartTextShipAddr</span></h2>

      <div class="cart-fields">
        <div class="cart-field cart-field--wide cart-field--required js-cart-field">
          <label class="cart-label" for="ship_name"><span class="xNgEditable xProperty-cartTextNameSurname xCaption-Name+surname" data-path="blog/settings/siteTexts/cartTextNameSurname" data-empty-caption="Name surname">Custom cartTextNameSurname</span></label>
          <input class="cart-input" type="text" name="ship_name" id="ship_name" autocomplete="shipping name" aria-required="true">
        </div>

        <div class="cart-field cart-field--wide cart-field--required js-cart-field">
          <label class="cart-label" for="ship_address"><span class="xNgEditable xProperty-cartTextAddress xCaption-Address" data-path="blog/settings/siteTexts/cartTextAddress" data-empty-caption="Address">Custom cartTextAddress</span></label>
          <input class="cart-input" type="text" name="ship_address" id="ship_address" autocomplete="shipping street-address" aria-required="true">
        </div>

        <div class="cart-field cart-field--required js-cart-field">
          <label class="cart-label" for="ship_phone"><span class="xNgEditable xProperty-cartTextPhoneNumber xCaption-Phone+number" data-path="blog/settings/siteTexts/cartTextPhoneNumber" data-empty-caption="Phone number">Custom cartTextPhoneNumber</span></label>
          <input class="cart-input" type="tel" name="ship_phone" id="ship_phone" autocomplete="shipping tel" aria-required="true">
        </div>

        <div class="cart-field js-cart-field">
          <label class="cart-label" for="ship_email"><span class="xNgEditable xProperty-cartTextEmail xCaption-Email" data-path="blog/settings/siteTexts/cartTextEmail" data-empty-caption="Email">Custom cartTextEmail</span></label>
          <input class="cart-input" type="email" name="ship_email" id="ship_email" autocomplete="shipping email">
        </div>

        <div class="cart-field cart-field--wide js-cart-field">
          <label class="cart-label" for="ship_notes"><span class="xNgEditable xProperty-cartTextComments xCaption-Comments" data-path="blog/settings/siteTexts/cartTextComments" data-empty-caption="Comments">Custom cartTextComments</span></label>
          <textarea class="cart-input" rows="3" name="ship_notes" id="ship_notes"></textarea>
        </div>
      </div>
    </section>

          <label class="cart-check cart-check--news">
        <input type="checkbox" id="receive_news_updates">
        <span class="xNgEditable xProperty-cartTextReceiveNews xCaption-Receive+news+and+updates" data-path="blog/settings/siteTexts/cartTextReceiveNews" data-empty-caption="Receive news and updates">Custom cartTextReceiveNews</span>
      </label>
    
    <section class="cart-section">
      <h2 class="cart-section-title" id="shoppingCartPaymentTitle"><span class="xNgEditable xProperty-cartTextCPM xCaption-Choose+payment+method" data-path="blog/settings/siteTexts/cartTextCPM" data-empty-caption="Choose payment method">Custom cartTextCPM</span></h2>

              <p class="cart-note"><span class="xNgEditable xProperty-cartTextPaymentDescription xCaption-Payment+description" data-path="blog/settings/siteTexts/cartTextPaymentDescription" data-empty-caption="Payment description">Custom cartTextPaymentDescription</span></p>
      
      <div class="cart-payment-methods" role="radiogroup" aria-labelledby="shoppingCartPaymentTitle">
                  <label class="cart-payment-option">
            <input type="radio" name="payment_method" value="creditcard" id="pm_creditcard" checked="checked">
            <span class="cart-payment-option-name"><span class="xNgEditable xProperty-cartTextCardPayment xCaption-Debit+or+credit+card" data-path="blog/settings/siteTexts/cartTextCardPayment" data-empty-caption="Debit or credit card">Custom cartTextCardPayment</span></span>
            <span class="cart-payment-option-marks" aria-hidden="true">
              <svg class="cart-payment-mark" viewBox="0 4 24 16" focusable="false"><path fill="#1A1F71" d="M9.112 8.262L5.97 15.758H3.92L2.374 9.775c-.094-.368-.175-.503-.461-.658C1.447 8.864.677 8.627 0 8.479l.046-.217h3.3a.904.904 0 01.894.764l.817 4.338 2.018-5.102zm8.033 5.049c.008-1.979-2.736-2.088-2.717-2.972.006-.269.262-.555.822-.628a3.66 3.66 0 011.913.336l.34-1.59a5.207 5.207 0 00-1.814-.333c-1.917 0-3.266 1.02-3.278 2.479-.012 1.079.963 1.68 1.698 2.04.756.367 1.01.603 1.006.931-.005.504-.602.725-1.16.734-.975.015-1.54-.263-1.992-.473l-.351 1.642c.453.208 1.289.39 2.156.398 2.037 0 3.37-1.006 3.377-2.564m5.061 2.447H24l-1.565-7.496h-1.656a.883.883 0 00-.826.55l-2.909 6.946h2.036l.405-1.12h2.488zm-2.163-2.656l1.02-2.815.588 2.815zm-8.16-4.84l-1.603 7.496H8.34l1.605-7.496z" /></svg>
              <svg class="cart-payment-mark" viewBox="0 0 24 15" focusable="false"><circle cx="8.5" cy="7.5" r="7" fill="#EB001B" /><circle cx="15.5" cy="7.5" r="7" fill="#F79E1B" /><path fill="#FF5F00" d="M12 1.44a7 7 0 0 1 0 12.12a7 7 0 0 1 0-12.12z" /></svg>
            </span>
          </label>

          <label class="cart-payment-option">
            <input type="radio" name="payment_method" value="paypal" id="pm_paypal">
            <span class="cart-payment-option-name"><span class="xNgEditable xProperty-cartTextPaypalPayment xCaption-PayPal" data-path="blog/settings/siteTexts/cartTextPaypalPayment" data-empty-caption="PayPal">Custom cartTextPaypalPayment</span></span>
            <span class="cart-payment-option-marks" aria-hidden="true">
              <svg class="cart-payment-mark" viewBox="0 0 24 24" focusable="false"><path fill="#003087" d="M7.016 19.198h-4.2a.562.562 0 0 1-.555-.65L5.093.584A.692.692 0 0 1 5.776 0h7.222c3.417 0 5.904 2.488 5.846 5.5-.006.25-.027.5-.066.747A6.794 6.794 0 0 1 12.071 12H8.743a.69.69 0 0 0-.682.583l-.325 2.056-.013.083-.692 4.39-.015.087zM19.79 6.142c-.01.087-.01.175-.023.261a7.76 7.76 0 0 1-7.695 6.598H9.007l-.283 1.795-.013.083-.692 4.39-.134.843-.014.088H6.86l-.497 3.15a.562.562 0 0 0 .555.65h3.612c.34 0 .63-.249.683-.585l.952-6.031a.692.692 0 0 1 .683-.584h2.126a6.793 6.793 0 0 0 6.707-5.752c.306-1.95-.466-3.744-1.89-4.906z" /></svg>
            </span>
          </label>
        
                  <label class="cart-payment-option">
            <input type="radio" name="payment_method" value="bank_transfer" id="pm_bank_transfer">
            <span class="cart-payment-option-name"><span class="xNgEditable xProperty-cartManualTransfer xCaption-Bank+transfer" data-path="blog/settings/siteTexts/cartManualTransfer" data-empty-caption="Bank transfer">Custom cartManualTransfer</span></span>
            <span class="cart-payment-option-marks" aria-hidden="true">
              <svg class="cart-payment-mark cart-payment-mark--icon" viewBox="0 0 24 24" focusable="false"><path d="M3 9.5 12 4l9 5.5M4.5 10v8M9.5 10v8M14.5 10v8M19.5 10v8M3 20.5h18" /></svg>
            </span>
          </label>
              </div>
    </section>

    <div class="cart-pay">
              <p class="cart-note"><span class="xNgEditable xProperty-cartTextCheckoutDescription xCaption-Checkout+description" data-path="blog/settings/siteTexts/cartTextCheckoutDescription" data-empty-caption="Checkout description">Custom cartTextCheckoutDescription</span></p>
      
      <div class="cart-pay-total">
        <span>Custom cartTextTotal</span>
        <span><span class="js-cart-total"></span> EUR</span>
      </div>

      
      <p class="cart-message cart-message--error js-cart-required-message" role="alert">
        <span class="xNgEditable xProperty-cartTextFillRequiredFields xCaption-Please+fill+in+all+required+fields" data-path="blog/settings/siteTexts/cartTextFillRequiredFields" data-empty-caption="Please fill in all required fields">Custom cartTextFillRequiredFields</span>
      </p>

      <div class="cart-pay-button js-cart-checkout-slot">
                  <div class="cart-button cart-button--primary"><span class="xNgEditable xProperty-cartTextCheckoutButton xCaption-Checkout+and+pay" data-path="blog/settings/siteTexts/cartTextCheckoutButton" data-empty-caption="Checkout and pay">Custom cartTextCheckoutButton</span></div>
              </div>

      <p class="cart-return">
                  <span class="xNgEditable xProperty-cartTextReturnStore xCaption-Return+to+store" data-path="blog/settings/siteTexts/cartTextReturnStore" data-empty-caption="Return to store">Custom cartTextReturnStore</span>
              </p>
    </div>
  </div>
</div>
