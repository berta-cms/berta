<div id="shoppingCartOuter">
  <div id="shoppingCartEmpty">
    <div class="xNgEditable xProperty-cartTextEmpty xCaption-shopping+cart+empty" data-path="blog/settings/siteTexts/cartTextEmpty" data-empty-caption="shopping cart empty">
        shopping cart is empty
    </div>
  </div>

  <div id="shoppingCartTitle">Cart</div>

  <div id="shoppingCartExpired">
    <div class="xNgEditable xProperty-cartTextExpired xCaption-shopping+cart+is+expired" data-path="blog/settings/siteTexts/cartTextExpired" data-empty-caption="shopping cart is expired">
        shopping cart is expired
    </div>
  </div>

  <div id="shoppingCartOrderPlaced" class="hidden">
    <h2 class="xOrderPlacedMessage"></h2>
    <p class="xOrderNumber"></p>
    <p><a href="javascript:;" class="xReturnToStore" onclick="closeShoppingCart();"></a></p>
  </div>

  <div id="shoppingCartContents">
    <div class="row thead">
      <div class="column column-half padded title">
                  <div class="xNgEditable xProperty-cartTextTitle xCaption-title" style="width: 100px;" data-path="blog/settings/siteTexts/cartTextTitle" data-empty-caption="title">
            <span class="xEmpty">&nbsp;title&nbsp;</span>          </div>
              </div>

      <div class="column column-half properties">
        <div class="row">
          <div class="column column-half padded qty">
                          <div class="xNgEditable xProperty-cartTextQuantity xCaption-quantity" data-path="blog/settings/siteTexts/cartTextQuantity" data-empty-caption="quantity">
                <span class="xEmpty">&nbsp;quantity&nbsp;</span>              </div>
                      </div>
          <div class="column column-fourth padded price">
                          <div class="xNgEditable xProperty-cartTextPrice xCaption-price" data-path="blog/settings/siteTexts/cartTextPrice" data-empty-caption="price">
                <span class="xEmpty">&nbsp;price&nbsp;</span>              </div>
                      </div>
          <div class="column column-fourth padded sum">
                          <div class="xNgEditable xProperty-cartTextSum xCaption-sum" data-path="blog/settings/siteTexts/cartTextSum" data-empty-caption="sum">
                <span class="xEmpty">&nbsp;sum&nbsp;</span>              </div>
                        (EUR)
          </div>
        </div>
      </div>
    </div>

    <div class="tbody prodList">
      <div class="row prodline">
        <div class="column column-half padded title"><span></span> <div class="image hidden"></div></div>
        <div class="column column-half">
          <div class="row">
            <div class="column column-half padded qty"><span></span> <span class="adremovecart"><a href="#" class="add">+</a> <a href="#" class="remove">-</a></span></div>
            <div class="column column-fourth padded price"></div>
            <div class="column column-fourth padded sum"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="row tbody shipping">
      <div class="column column-half padded promo">
                  <div id="promoCodeEntry">
                          <div class="xNgEditable xProperty-cartTextPromoCode xCaption-Promo+code" data-path="blog/settings/siteTexts/cartTextPromoCode" data-empty-caption="Promo code">
                <span class="xEmpty">&nbsp;Promo code&nbsp;</span>              </div>
                        <span class="pull-right">
              <input type="text" name="promo_code" id="promo_code" />
                              <div class="xNgEditable xProperty-cartTextPromoBtn xCaption-OK" data-path="blog/settings/siteTexts/cartTextPromoBtn" data-empty-caption="OK">
                  <span class="xEmpty">&nbsp;OK&nbsp;</span>                </div>
                          </span>
          </div>
              </div>

      <div class="column column-half padded">
        <div class="padded-left">
          <div class="cCartShippingTo xNgEditable xProperty-cartTextShippingTo xCaption-shipping+to" data-path="blog/settings/siteTexts/cartTextShippingTo" data-empty-caption="shipping to">
            shipping to
          </div>

          <select id="shipping_select" class="pull-right">
                          <option value="1">Europe</option>
                      </select>
        </div>
      </div>
    </div>

    <div class="row tbody">
      <div class="column padded-left column-half pull-right">
        <div class="padded shippingTotal">
          <span class="xNgEditable xProperty-shippingTotalText xCaption-Shipping" data-path="blog/settings/siteTexts/shippingTotalText" data-empty-caption="Shipping">
            Shipping
          </span>
          <div class="total pull-right">EUR <span id="shippingTotalSum"></span></div>
        </div>
      </div>
    </div>

    <div class="row tbody discount">
      <div class="column column-half padded-left pull-right">
        <div class="padded shoppingCartDiscount">
                      <div class="xNgEditable xProperty-cartTextDiscount xCaption-discount" data-path="blog/settings/siteTexts/cartTextDiscount" data-empty-caption="discount">
              <span class="xEmpty">&nbsp;discount&nbsp;</span>            </div>
                    <span class="pull-right sumDiscount"></span>
        </div>
      </div>
    </div>

    <div class="row tbody total">
      <div class="column column-half padded-left pull-right">
        <div class="padded shoppingCartTotal">
                      <div class="xNgEditable xProperty-cartTextTotal xCaption-total" data-path="blog/settings/siteTexts/cartTextTotal" data-empty-caption="total">
              <span class="xEmpty">&nbsp;total&nbsp;</span>            </div>
          
                      <div class="xNgEditable xProperty-cartTextInclVat xCaption-incl+vat" data-path="blog/settings/siteTexts/cartTextInclVat" data-empty-caption="incl vat">
              <span class="xEmpty">&nbsp;incl vat&nbsp;</span>            </div>
                    <div class="pull-right total">EUR <span class="sumTotal"></span></div>
          <div class="vatprice hidden"> (<span class="vatRate"></span>%)<span class="pull-right">EUR <span class="vatAmount"></span></span></div>
        </div>
      </div>
    </div>
  </div>

  <div class="row" id="cartBottomPart">
    <div class="column column-half" id="cartFromleftPart">
      <div class="padded-right">
        <input type="hidden" name="cartemail" value="seller@berta.test" id="cartemail">
        <div class="cc-fields" id="billing_address_form">
          <h2 class="xNgEditable xProperty-cartTextBillAddr xCaption-billing+address" data-path="blog/settings/siteTexts/cartTextBillAddr" data-empty-caption="billing address">
            Billing address
          </h2>

          <div class="padded">
            <p class="checkbox">
                              <div class="xNgEditable xProperty-cartTextLegalPerson xCaption-legal+person" data-path="blog/settings/siteTexts/cartTextLegalPerson" data-empty-caption="legal person">
                  <span class="xEmpty">&nbsp;legal person&nbsp;</span>                </div>
                          </p>

            <p class="xLegalPerson">
              <label for="company">
                                  <div class="xNgEditable xProperty-cartTextCompany xCaption-Company" data-path="blog/settings/siteTexts/cartTextCompany" data-empty-caption="Company">
                    <span class="xEmpty">&nbsp;Company&nbsp;</span>                  </div>
                              </label>
                          </p>

            <p class="xLegalPerson">
              <label for="company_reg_no">
                                  <div class="xNgEditable xProperty-cartTextCompanyRegNo xCaption-Company+reg.+no." data-path="blog/settings/siteTexts/cartTextCompanyRegNo" data-empty-caption="Company reg. no.">
                    <span class="xEmpty">&nbsp;Company reg. no.&nbsp;</span>                  </div>
                              </label>
                          </p>

            <p class="xLegalPerson">
              <label for="legal_address">
                                  <div class="xNgEditable xProperty-cartTextLegalAddress xCaption-Legal+address" data-path="blog/settings/siteTexts/cartTextLegalAddress" data-empty-caption="Legal address">
                    <span class="xEmpty">&nbsp;Legal address&nbsp;</span>                  </div>
                              </label>
                          </p>

            <p>
              <label for="name">
                                  <div class="xNgEditable xProperty-cartTextNameSurname xCaption-name+surname" data-path="blog/settings/siteTexts/cartTextNameSurname" data-empty-caption="name surname">
                    <span class="xEmpty">&nbsp;name surname&nbsp;</span>                  </div>
                              </label>
                          </p>

            <p>
              <label for="address">
                                  <div class="xNgEditable xProperty-cartTextAddress xCaption-address" data-path="blog/settings/siteTexts/cartTextAddress" data-empty-caption="address">
                    <span class="xEmpty">&nbsp;address&nbsp;</span>                  </div>
                              </label>
                          </p>

            <p>
              <label for="phone">
                                  <div class="xNgEditable xProperty-cartTextPhoneNumber xCaption-phone+number" data-path="blog/settings/siteTexts/cartTextPhoneNumber" data-empty-caption="phone number">
                    <span class="xEmpty">&nbsp;phone number&nbsp;</span>                  </div>
                              </label>
                          </p>

            <p>
              <label for="email">
                                  <div class="xNgEditable xProperty-cartTextEmail xCaption-email" data-path="blog/settings/siteTexts/cartTextEmail" data-empty-caption="email">
                    <span class="xEmpty">&nbsp;email&nbsp;</span>                  </div>
                              </label>
                          </p>

            <p>
              <label for="notes">
                                  <div class="xNgEditable xProperty-cartTextComments xCaption-comments" data-path="blog/settings/siteTexts/cartTextComments" data-empty-caption="comments">
                    <span class="xEmpty">&nbsp;comments&nbsp;</span>                  </div>
                              </label>
                          </p>

                          <div class="xNgEditable xProperty-cartTextDeliverBilling xCaption-deliver+to+billing_address" data-path="blog/settings/siteTexts/cartTextDeliverBilling" data-empty-caption="deliver to billing_address">
                <span class="xEmpty">&nbsp;deliver to billing_address&nbsp;</span>              </div>
                      </div>
        </div>

        <div class="cc-fields" id="shipping_address_form">
          <h2 class="xNgEditable xProperty-cartTextShipAddr xCaption-shipping+address" data-path="blog/settings/siteTexts/cartTextShipAddr" data-empty-caption="shipping address">
            <span class="xEmpty">&nbsp;shipping address&nbsp;</span>          </h2>

          <div class="padded">
            <p>
              <label for="ship_name">
                                  <div class="xNgEditable xProperty-cartTextNameSurname xCaption-name+surname" data-path="blog/settings/siteTexts/cartTextNameSurname" data-empty-caption="name surname">
                    <span class="xEmpty">&nbsp;name surname&nbsp;</span>                  </div>
                              </label>
                          </p>

            <p>
              <label for="ship_address">
                                  <div class="xNgEditable xProperty-cartTextAddress xCaption-address" data-path="blog/settings/siteTexts/cartTextAddress" data-empty-caption="address">
                    <span class="xEmpty">&nbsp;address&nbsp;</span>                  </div>
                              </label>
                          </p>

            <p>
              <label for="ship_phone">
                                  <div class="xNgEditable xProperty-cartTextPhoneNumber xCaption-phone+number" data-path="blog/settings/siteTexts/cartTextPhoneNumber" data-empty-caption="phone number">
                    <span class="xEmpty">&nbsp;phone number&nbsp;</span>                  </div>
                              </label>
                          </p>

            <p>
              <label for="ship_email">
                                  <div class="xNgEditable xProperty-cartTextEmail xCaption-email" data-path="blog/settings/siteTexts/cartTextEmail" data-empty-caption="email">
                    <span class="xEmpty">&nbsp;email&nbsp;</span>                  </div>
                              </label>
                          </p>

            <p>
              <label for="ship_notes">
                                  <div class="xNgEditable xProperty-cartTextComments xCaption-comments" data-path="blog/settings/siteTexts/cartTextComments" data-empty-caption="comments">
                    <span class="xEmpty">&nbsp;comments&nbsp;</span>                  </div>
                              </label>
                          </p>
          </div>
        </div>

                  <div class="padded">
            <div class="xNgEditable xProperty-cartTextReceiveNews xCaption-receive+news+and+updates" data-path="blog/settings/siteTexts/cartTextReceiveNews" data-empty-caption="receive news and updates">
              <span class="xEmpty">&nbsp;receive news and updates&nbsp;</span>            </div>
          </div>
              </div>
    </div>

    <div class="column column-half">
      <div id="cartFromrightPart" class="padded-left">
        <h2 id="cartFromRightTitle" class="xNgEditable xProperty-cartTextCPM xCaption-choose+payment+method" data-path="blog/settings/siteTexts/cartTextCPM" data-empty-caption="choose payment method">
          Choose payment method
        </h2>

        <div class="padded choosePaymentMethod">

                      <p class="xNgEditable xProperty-cartTextPaymentDescription xCaption-payment+description" data-path="blog/settings/siteTexts/cartTextPaymentDescription" data-empty-caption="payment description">
              <span class="xEmpty">&nbsp;payment description&nbsp;</span>            </p>
          
                      <div class="choosePaymentRadio">
              <label for="pm_creditcard"><input type="radio" name="payment_method" value="creditcard" id="pm_creditcard" checked="checked" />
              <img src="/_plugin_shop/images/creditcard.png" alt="Credit card" /></label>
            </div>
            <div class="choosePaymentRadio">
              <label for="pm_paypal"><input type="radio" name="payment_method" value="paypal" id="pm_paypal" />
              <img src="/_plugin_shop/images/paypal.png" alt="Paypal" /></label>
            </div>
          
                      <div class="choosePaymentRadio">
              <label for="pm_bank_transfer"><input type="radio" name="payment_method" value="bank_transfer" id="pm_bank_transfer">
                                  <div class="xNgEditable xProperty-cartManualTransfer xCaption-Manual+transfer" data-path="blog/settings/siteTexts/cartManualTransfer" data-empty-caption="Manual transfer">
                    <span class="xEmpty">&nbsp;Manual transfer&nbsp;</span>                  </div>
                              </label>
            </div>
                  </div>

        <div class="padded checkOut">
                      <p class="xNgEditable xProperty-cartTextCheckoutDescription xCaption-checkout+description" data-path="blog/settings/siteTexts/cartTextCheckoutDescription" data-empty-caption="checkout description">
              <span class="xEmpty">&nbsp;checkout description&nbsp;</span>            </p>
          
          <p class="text-right checkoutSumTotal">total EUR <span class="sumTotal"></span></p>

                      
            <div class="xNgEditable xProperty-cartTextFillRequiredFields xCaption-Please+fill+in+all+required+fields" data-path="blog/settings/siteTexts/cartTextFillRequiredFields" data-empty-caption="Please fill in all required fields">
              <span class="xEmpty">&nbsp;Please fill in all required fields&nbsp;</span>            </div>

            <div class="xNgEditable xProperty-cartTextCheckoutButton xCaption-checkout+and+pay" data-path="blog/settings/siteTexts/cartTextCheckoutButton" data-empty-caption="checkout and pay">
              <span class="xEmpty">&nbsp;checkout and pay&nbsp;</span>            </div>

            <div class="xNgEditable xProperty-cartTextReturnStore xCaption-return+to+store" data-path="blog/settings/siteTexts/cartTextReturnStore" data-empty-caption="return to store">
              <span class="xEmpty">&nbsp;return to store&nbsp;</span>            </div>

          
          <div id="shoppingCart" class="hidden"></div>
        </div>
      </div>
    </div>
  </div>
</div>
