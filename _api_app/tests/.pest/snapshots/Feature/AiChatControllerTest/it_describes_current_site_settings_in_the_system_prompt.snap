berta:
  installed: 1
siteTexts (Texts in the website):
  siteHeading (Site heading — Name of your site. Visible in all sections.): 
template (Template):
  template (Template — Templates are like skins or themes for your site. You can choose one template from the ones installed in your templates folder. To add a new template to this list, upload it to the templates folder via FTP.): messy-0.4.2
theme (Theme):
  theme (Choose theme — Themes are ready made sites with predefined design settings.): /themes
texts (Texts):
  ownerName (Your name — Your name will be put in a meta-tag in the code of your site. You can choose any name ;)): 
  pageTitle (Page title (title bar) — Text that appears in the bowser title bar): My site
  metaDescription (<META> description — Short site description. It should not be longer than one or two sentences.): Personal portfolio built with Berta
  unknownKey: kept
pageLayout (Page layout):
  favicon (Favicon — Small picture to display in the address bar of the browser. The file must be in PNG format and 180x180 pixels big.): 
  gridStep (Grid step — Distance in pixels for snap-to-grid dragging.): 10
  showGrid (Show gridlines — Choose "yes" to show gridlines in background. Available only in Messy template.): no
  gridColor (Gridlines color): black
navigation (Navigation):
  landingSectionVisible (Is first section visible in menu? — Choose "no" to hide the first section in the main menu. Link from the page title (or header image) will lead to it. NOTE: This setting has no effect, if the section has a submenu; then it is visible at all times.): yes
  landingSectionPageHeadingVisible (Show page heading in first section? — Choose "no" to hide page heading in first section.): yes
  landingSectionMenuVisible (Show menu in first section? — Choose "no" to hide the menu in first section.): yes
  alwaysSelectTag (Always auto-select a submenu item? — Choose "yes" to automatically select the first submenu item when clicking on a menu item. This works only when there is a submenu.): yes
  backToTopEnabled (Enable navigation to page top — Shows navigation button at the bottom when page is scrolled.): no
entryLayout (Entry layout):
  galleryFullScreenSettings (Gallery fullscreen settings:): 
  galleryFullScreenDefault (Is enabled by default — Enables gallery fullscreen mode for new entries.): yes
  galleryFullScreenBackground (Background color — Color of the fullscreen gallery background.): black
  galleryFullScreenImageNumbers (Image numbers — Enables fullscreen gallery slide numbers.): yes
  galleryFullScreenCaptionAlign (Caption alignment — Positioning of the image caption text.): left
  group_gallery (Image gallery appearance:): 
  gallerySlideshowAutoRewind (Slideshow loop mode): no
  gallerySlideNumberVisibilityDefault (Show slideshow image numbers — Set the default state of image number visibility in slideshow galleries.): yes
media (Media):
  imagesSmallWidth (Small image width — Maximum size of a small image (visible if 'Small images' are switched on in the gallery editor). These settings don't affect original image.): 200
  imagesSmallHeight (Small image height): 200
  imagesMediumWidth (Medium image width — Maximum size of a medium image (visible if 'Medium images' are switched on in the gallery editor). These settings don't affect original image.): 400
  imagesMediumHeight (Medium image height): 400
  imagesLargeWidth (Large image width — Maximum size of a large image (visible if 'Large images' are switched on in the gallery editor). These settings don't affect original image.): 600
  imagesLargeHeight (Large image height): 600
socialMediaLinks (Social media buttons):
  location (Location — Location of social media buttons. Content of additional text or additional footer will be replaced.): footer
socialMediaButtons (Custom social media buttons):
  socialMediaHTML (HTML code — Paste or write your HTML code here.): 
  socialMediaJS (Javascript code — Paste or write your Javascript code here.): 
  socialMediaLocation (Location — Location of social media buttons. Content of additional text or additional footer will be replaced.): footer
